<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Personal portfolio website of Md. Sazid Hasan, BSc in Data Science student at UIU." />
  <title>Md. Sazid Hasan | Data Science Portfolio</title>

  <style>
    :root {
      --bg: #07111f;
      --bg-soft: #0d1a2d;
      --card: rgba(17, 31, 52, 0.72);
      --text: #eef6ff;
      --muted: #a9bad0;
      --primary: #62d8ff;
      --secondary: #8b7cff;
      --border: rgba(255,255,255,.10);
      --shadow: 0 20px 60px rgba(0,0,0,.30);
      --max: 1120px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 15% 10%, rgba(98,216,255,.14), transparent 28%),
        radial-gradient(circle at 85% 20%, rgba(139,124,255,.15), transparent 30%),
        var(--bg);
      color: var(--text);
      line-height: 1.7;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }

    .container {
      width: min(92%, var(--max));
      margin: auto;
    }

    /* NAVBAR */
    header {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
      backdrop-filter: blur(18px);
      background: rgba(7,17,31,.65);
      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: .5px;
    }

    .logo span { color: var(--primary); }

    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      color: var(--muted);
      font-size: .95rem;
      transition: .25s;
    }

    .nav-links a:hover { color: var(--primary); }

    .menu-btn {
      display: none;
      border: 1px solid var(--border);
      background: var(--card);
      color: white;
      padding: 8px 11px;
      border-radius: 10px;
      cursor: pointer;
      font-size: 1.1rem;
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 120px 0 70px;
      position: relative;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.25fr .75fr;
      gap: 55px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      padding: 7px 13px;
      border: 1px solid rgba(98,216,255,.25);
      background: rgba(98,216,255,.07);
      color: var(--primary);
      border-radius: 999px;
      font-size: .82rem;
      margin-bottom: 20px;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5.8rem);
      line-height: .98;
      letter-spacing: -3px;
      margin-bottom: 22px;
    }

    h1 span {
      background: linear-gradient(100deg, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      color: transparent;
    }

    .hero p {
      max-width: 650px;
      color: var(--muted);
      font-size: 1.08rem;
    }

    .buttons {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 30px;
    }

    .btn {
      padding: 12px 19px;
      border-radius: 12px;
      border: 1px solid var(--border);
      font-weight: 700;
      transition: .25s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn-primary {
      color: #03101b;
      background: linear-gradient(100deg, var(--primary), #a8eeff);
      border: none;
    }

    .btn-secondary {
      background: rgba(255,255,255,.04);
      color: white;
    }

    .btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 30px rgba(98,216,255,.14);
    }

    .hero-card {
      min-height: 400px;
      border: 1px solid var(--border);
      border-radius: 28px;
      background:
        linear-gradient(145deg, rgba(98,216,255,.10), rgba(139,124,255,.08)),
        var(--card);
      box-shadow: var(--shadow);
      display: grid;
      place-items: center;
      position: relative;
      overflow: hidden;
    }

    .hero-card::before,
    .hero-card::after {
      content: "";
      position: absolute;
      border-radius: 50%;
      filter: blur(2px);
    }

    .hero-card::before {
      width: 220px;
      height: 220px;
      background: rgba(98,216,255,.12);
      top: -90px;
      right: -70px;
    }

    .hero-card::after {
      width: 180px;
      height: 180px;
      background: rgba(139,124,255,.13);
      bottom: -80px;
      left: -60px;
    }

    .profile-placeholder {
      width: 190px;
      height: 190px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,.18);
      background: linear-gradient(145deg, #152c48, #0a1728);
      display: grid;
      place-items: center;
      font-size: 4.2rem;
      font-weight: 900;
      color: var(--primary);
      box-shadow: 0 0 80px rgba(98,216,255,.12);
    }

    /* SECTIONS */
    section { padding: 100px 0; }

    .section-title {
      margin-bottom: 45px;
    }

    .section-title small {
      color: var(--primary);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .section-title h2 {
      font-size: clamp(2rem, 4vw, 3.2rem);
      margin-top: 6px;
      letter-spacing: -1px;
    }

    .section-title p {
      color: var(--muted);
      max-width: 650px;
      margin-top: 10px;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 28px;
      box-shadow: var(--shadow);
    }

    .card p { color: var(--muted); }

    .facts {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .fact {
      padding: 18px;
      background: rgba(255,255,255,.035);
      border: 1px solid var(--border);
      border-radius: 16px;
    }

    .fact strong { display: block; color: var(--primary); margin-bottom: 3px; }
    .fact span { color: var(--muted); font-size: .9rem; }

    /* SKILLS */
    .skills {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .skill-card h3 { margin-bottom: 10px; }
    .skill-card p { font-size: .94rem; }

    .tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    .tag {
      font-size: .78rem;
      color: #dceeff;
      padding: 6px 10px;
      background: rgba(98,216,255,.07);
      border: 1px solid rgba(98,216,255,.15);
      border-radius: 999px;
    }

    /* PROJECTS */
    .projects {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .project {
      position: relative;
      overflow: hidden;
      transition: .3s;
    }

    .project:hover { transform: translateY(-6px); }

    .project-number {
      color: var(--primary);
      font-size: .8rem;
      font-weight: 900;
    }

    .project h3 { margin: 8px 0; }

    .project p {
      color: var(--muted);
      font-size: .92rem;
    }

    /* CONTACT */
    .contact-box {
      text-align: center;
      padding: 65px 25px;
      background:
        linear-gradient(135deg, rgba(98,216,255,.09), rgba(139,124,255,.09)),
        var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
    }

    .contact-box h2 { font-size: clamp(2rem, 5vw, 3.5rem); }
    .contact-box p { color: var(--muted); max-width: 600px; margin: 12px auto 0; }

    .socials {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 25px;
    }

    /* FOOTER */
    footer {
      border-top: 1px solid var(--border);
      padding: 28px 0;
      color: var(--muted);
      text-align: center;
      font-size: .88rem;
    }

    /* REVEAL */
    .reveal {
      opacity: 0;
      transform: translateY(25px);
      transition: .7s ease;
    }

    .reveal.show {
      opacity: 1;
      transform: translateY(0);
    }

    /* RESPONSIVE */
    @media (max-width: 850px) {
      .hero-grid,
      .about-grid {
        grid-template-columns: 1fr;
      }

      .hero-card {
        min-height: 300px;
      }

      .skills,
      .projects {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 620px) {
      .nav-links {
        display: none;
        position: absolute;
        top: 72px;
        left: 4%;
        right: 4%;
        padding: 18px;
        flex-direction: column;
        background: #0b1829;
        border: 1px solid var(--border);
        border-radius: 16px;
      }

      .nav-links.active { display: flex; }
      .menu-btn { display: block; }

      h1 { letter-spacing: -2px; }
      section { padding: 75px 0; }

      .skills,
      .projects,
      .facts {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

